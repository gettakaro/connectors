# ─────────────────────────────────────────────────────────────────────────────
# dev-servers — copy to .env and fill in. NEVER commit .env.
#   cp dev-servers/.env.example dev-servers/.env && chmod 600 dev-servers/.env
# ─────────────────────────────────────────────────────────────────────────────

# === Takaro connection (shared by every connector) ===
TAKARO_WS_URL=wss://connect.takaro.io/
# Registration token from the Takaro dashboard. Required before install/start.
TAKARO_REGISTRATION_TOKEN=
TAKARO_DEBUG=false

# === Identity tokens ===
# Each game registers with Takaro under its own identity token, so one Takaro
# organisation can hold all of these servers at once. Change them only if you
# want a game to register as a brand-new server in the dashboard.
TAKARO_IDENTITY_RUST=takaro-dev-rust
TAKARO_IDENTITY_PAPER=takaro-dev-paper
TAKARO_IDENTITY_NEOFORGE=takaro-dev-neoforge
TAKARO_IDENTITY_FABRIC=takaro-dev-fabric
TAKARO_IDENTITY_FABRIC_26_1_2=takaro-dev-fabric-26.1.2
TAKARO_IDENTITY_7D2D=takaro-dev-7d2d
TAKARO_IDENTITY_VALHEIM=takaro-dev-valheim
TAKARO_IDENTITY_CONAN=takaro-dev-conan
TAKARO_IDENTITY_ZOMBOID=takaro-dev-zomboid

# === Shared credentials (placeholders — change them) ===
RCON_PASSWORD=replace-with-unique-password
ADMIN_PASSWORD=replace-with-unique-password

# === Resource guard ===
# start.sh refuses to exceed this many GB of estimated RAM across running games.
DEV_SERVERS_RAM_BUDGET_GB=40
# install-all.sh aborts if free disk drops below this many GB.
DEV_SERVERS_MIN_FREE_GB=40

# Rig focus (dev-servers/scripts/focus.sh). A rig lock younger than this many
# hours counts as "a campaign is live here", and focus.sh apply refuses to stop it.
DEV_SERVERS_FOCUS_IDLE_HOURS=6
# Where campaigns keep their <game>-rig.lock files, space separated, globs allowed.
# Blank means $HOME/*/.runtime.
DEV_SERVERS_RIG_LOCK_DIRS=

# === Rust ===
RUST_SERVER_NAME="Takaro Dev Rust"
RUST_SERVER_SEED=12345
RUST_SERVER_WORLDSIZE=1000
RUST_SERVER_MAXPLAYERS=10

# === Minecraft ===
MINECRAFT_MEMORY=2G

# === 7 Days to Die ===
SEVEND2D_SERVER_NAME="Takaro Dev 7D2D"

# === Valheim ===
VALHEIM_SERVER_NAME="Takaro Dev Valheim"
VALHEIM_WORLD_NAME=TakaroDev
# Valheim requires a server password of at least 5 characters.
VALHEIM_SERVER_PASSWORD=replace-with-unique-password
# disabled | optional | required — see dev-servers/README.md
VALHEIM_COMPANION_MODE=optional

# === Terraria ===
TERRARIA_WORLD_NAME=TakaroDev
TERRARIA_WORLD_SIZE=1
TERRARIA_DIFFICULTY=0
TERRARIA_MAXPLAYERS=8
# Leave blank to have install.sh generate one and print it for the dashboard.
TERRARIA_REST_TOKEN=

# === Conan Exiles ===
CONAN_SERVER_NAME="Takaro Dev Conan"

# === Palworld ===
PALWORLD_SERVER_NAME="Takaro Dev Palworld"
PALWORLD_MAXPLAYERS=8

# Additional servers (compose/zomboid.yml and compose/enshrouded.yml)
ZOMBOID_SERVER_PASSWORD=replace-with-a-unique-password
ZOMBOID_ADMIN_PASSWORD=replace-with-a-unique-password
ZOMBOID_RCON_PASSWORD=replace-with-a-unique-password
TAKARO_ENSHROUDED_PLUGIN_TOKEN=
ENSHROUDED_ADMIN_PASSWORD=replace-with-a-unique-password
ENSHROUDED_PLAYER_PASSWORD=replace-with-a-unique-password
ENSHROUDED_GUEST_PASSWORD=replace-with-a-unique-password

# ── DayZ ─────────────────────────────────────────────────────────────────────
TAKARO_IDENTITY_DAYZ=takaro-dev-dayz
DAYZ_SERVER_PASSWORD=replace-with-unique-password
DAYZ_ADMIN_PASSWORD=replace-with-unique-password
DAYZ_RCON_PASSWORD=replace-with-unique-password
# Swap to a ladder variant by pointing these at another packed mod folder.
DAYZ_MOD_DIR=../_data/dayz/mod/@takarointegration
DAYZ_SERVERMOD=@takarointegration

# ── RuneScape: Dragonwilds dev rig (compose/dragonwilds.yml) ─────────────────
TAKARO_IDENTITY_DRAGONWILDS=takaro-dev-dragonwilds
TAKARO_DRAGONWILDS_PLUGIN_TOKEN=
DRAGONWILDS_DEV_ADMIN_PASSWORD=
DRAGONWILDS_DEV_WORLD_PASSWORD=
DRAGONWILDS_OWNER_ID=

# ── Connector source trees (optional) ────────────────────────────────────────
# The DayZ and Dragonwilds sidecars are built from source trees that are not part
# of this repository yet. Point these at a local checkout to build them; the
# defaults assume games/<game>/ inside this repo.
DAYZ_BRIDGE_SRC=../../games/dayz/DayZ-Bridge
DAYZ_BRIDGE_DOCKERFILE=../../../dev-servers/images/dayz-bridge/Dockerfile
DRAGONWILDS_SIDECAR_SRC=../../games/dragonwilds/sidecar
ENSHROUDED_SIDECAR_SRC=../../games/enshrouded/sidecar

# ── Enshrouded (compose/enshrouded.yml) ──────────────────────────────────────
TAKARO_IDENTITY_ENSHROUDED=takaro-dev-enshrouded

# ── VEIN dev rig (compose/vein.yml) ──────────────────────────────────────────
TAKARO_IDENTITY_VEIN=takaro-dev-vein
# Token for authenticated loopback diagnostics in the dev rig: openssl rand -hex 24.
# Direct Takaro communication does not use it; the rig requires it for smoke checks.
TAKARO_VEIN_PLUGIN_TOKEN=
# SteamID64s that get admin/superadmin on the rig (comma separated).
VEIN_DEV_ADMIN_STEAMIDS=
# Join password for the test server.
VEIN_DEV_WORLD_PASSWORD=change-me

# ── Dune: Awakening dev rig (compose/dune.yml) ───────────────────────────────
# The server is Steam TOOL app 4754530; install.sh fetches linux depot 4754532 with
# DepotDownloader (anonymous) and `docker load`s the image tarballs out of it.
TAKARO_IDENTITY_DUNE=takaro-dev-dune
# Funcom self-hosting token (JWT) from https://account.duneawakening.com. SECRET.
# Everything up to text-router boots without it; director/gateway/survival need it to
# register the world with FLS, and without that no client can find or join the world.
DUNE_FLS_SECRET=
# ServerCommandsAuthToken — authenticates every GM command. Must be identical on the map
# process and in the sidecar. install.sh generates one: openssl rand -hex 32
DUNE_GM_AUTH_TOKEN=
# Password of the broker account the sidecar publishes GM commands as (user `fls`).
DUNE_GM_AMQP_PASS=
DUNE_GM_AMQP_USER=fls
DUNE_GM_PUBLISHER=amqp
# Shared secret the battlegroup services use to sign RabbitMQ HTTP auth tokens.
DUNE_RMQ_HTTP_TOKEN_AUTH_SECRET=
# Battlegroup Postgres (schema `dune` inside this database).
DUNE_PG_PASSWORD=
DUNE_DB_NAME=dune_sb_1_5_3_0
# LAN join password — short on purpose.
DUNE_WORLD_PASSWORD=change-me
DUNE_WORLD_NAME="Takaro Dev Dune"
# MUST be sh-<HostId lowercased>-<6 random lowercase letters>, where HostId is the 16-hex
# `HostId` claim inside DUNE_FLS_SECRET (Funcom's setup/world.sh derives it exactly this way).
# FLS keys the battlegroup's service authorization on it, so a name that does not start with
# sh-<your HostId>- registers with 403 ACCESS_DENIED. Once registered it must NEVER change.
#   HostId:  echo -n "$DUNE_FLS_SECRET" | jq -R 'split(".")|.[1]|@base64d|fromjson|.HostId'
#   suffix:  tr -dc 'a-z' < /dev/urandom | fold -w6 | head -n1
DUNE_WORLD_UNIQUE_NAME=
DUNE_FARM_REGION=Europe
# The address clients and FLS are told to use: the host address a Dune client can reach.
EXTERNAL_ADDRESS=
# Image names and the depot manifest are resolved from catalog/dune/targets/ by install.sh.
DUNE_PARTITION_PRESET=basic_battlegroup   # dune.initialize_partitions_<preset>(); list: basic_survival_1 basic_battlegroup full_battlegroup development_battlegroup igw_training ...
# Build contexts / sources for the connector (campaign worktree, outside this repo).
DUNE_SIDECAR_SRC=../../games/dune/sidecar
DUNE_PLUGIN_SRC=../../games/dune/mod
# Set to /opt/takaro/libtakaro-dune.so to LD_PRELOAD the plugin into the map process.
DUNE_PLUGIN_SO=
TAKARO_DUNE_PLUGIN_TOKEN=

# Lane L2: `0.0.0.0` lets the sidecar container reach the plugin over the private compose network
# (the port is never published to the host, and every route needs TAKARO_DUNE_PLUGIN_TOKEN).
# Uncomment ONLY if the sidecar runs in its own network namespace and must reach the plugin over
# the private compose network. The port is never published to the host and every route still
# needs TAKARO_DUNE_PLUGIN_TOKEN, but loopback is the safe default.
#TAKARO_DUNE_PLUGIN_BIND=0.0.0.0
#DUNE_PLUGIN_URL=http://survival:18890
