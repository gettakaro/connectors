{
  "contract": "TakaroConan DevKit build source contract",
  "version": 2,
  "modName": "TakaroConan",
  "architecture": "sidecar-datacmd-client-renderer",
  "requiredAssets": [
    {
      "key": "modController",
      "assetName": "TakaroConan_ModController",
      "path": "Content/Mods/TakaroConan/TakaroConan_ModController",
      "requiredProof": ["loads on server and client", "registers the TakaroChat command table"]
    },
    {
      "key": "dataActorCommand",
      "assetName": "BP_TakaroChatCommand",
      "path": "Content/Mods/TakaroConan/BP_TakaroChatCommand",
      "requiredProof": ["decodes DataCmd parameter 1", "uses a reliable owning-client RPC", "renders through real Conan chat widgets"]
    },
    {
      "key": "consoleCommandTable",
      "assetName": "DT_TakaroConsoleCommands",
      "path": "Content/Mods/TakaroConan/DT_TakaroConsoleCommands",
      "requiredProof": ["maps TakaroChat to BP_TakaroChatCommand"]
    }
  ],
  "runtimeContract": {
    "outboundDispatch": "con <player-index> dc TakaroChat \"<sender>\" \"<message>\"",
    "clientRenderer": "W_ChatWindow/W_RichChatLine/FCRichTextBlock",
    "clientLogPrefix": "TakaroConan: rendered ",
    "inboundChatSource": "Conan dedicated-server ChatWindow log",
    "clientHttpPolling": false,
    "clientContainsSecrets": false,
    "inboundChatRequiresStableIdentity": true,
    "supportsServerWideChat": true,
    "supportsTargetedChat": true,
    "supportsInboundChat": true,
    "usesPippiRconChatCommands": false
  },
  "requiredReturnedEvidence": {
    "buildReport": "BUILD_REPORT.md",
    "sourceEvidence": "SOURCE_EVIDENCE.md",
    "artifactManifest": "artifact-manifest.json",
    "sourceContract": "BUILD_SOURCE_CONTRACT.json",
    "artifactManifestMustReferenceSourceContract": true
  }
}
