{
  "schemaVersion": 1,
  "id": "zomboid",
  "name": "Project Zomboid",
  "connector": "zomboid",
  "platforms": ["linux"],
  "sources": {
    "steam": {
      "provider": "steam",
      "baseUrl": "https://store.steampowered.com",
      "watch": {
        "kind": "game",
        "component": "zomboid",
        "app": 380870,
        "os": "linux",
        "depots": ["380871", "380873"],
        "channels": {
          "public": {"branch": "public"}
        },
        "knownBranches": ["unstable", "regex:^[0-9]+\\.[0-9]+$", "regex:^legacy[0-9]+$", "regex:^b[0-9]+"]
      }
    }
  },
  "build": {"system": "script", "projectDir": "games/zomboid"},
  "componentRoles": {
    "agent": {
      "description": "Server-side -javaagent jar loaded into the dedicated server JVM (JAVA_TOOL_OPTIONS)",
      "artifactPattern": "takaro-zomboid-agent-{target}-{version}.jar"
    }
  },
  "legacyAssetAliases": {"TakaroConnector-{version}.jar": "linux-42.21.0/agent"},
  "devServers": {"composeFile": "zomboid.yml"},
  "icons": {
    "game": "zomboid",
    "mapper": "zomboid",
    "data": {
      "source": "server-depot",
      "input": "server",
      "depots": ["380871"],
      "files": ["regex:^media/scripts/.*\\.txt$"]
    },
    "pixels": {
      "source": "client",
      "app": 108600,
      "depot": 108604,
      "decoder": "pz-texturepack",
      "files": [
        "media/texturepacks/UI2.pack",
        "media/texturepacks/UI.pack",
        "media/texturepacks/IconsMoveables.pack",
        "media/texturepacks/Tiles2x.pack",
        "media/texturepacks/Tiles2x.floor.pack"
      ],
      "clientBuilds": {"42.21.0": [25485521]}
    },
    "secrets": []
  }
}
