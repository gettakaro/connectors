{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gettakaro/connectors/catalog/schema/v1/verify-report.schema.json",
  "title": "Runtime verification report",
  "description": "The evidence one `takaro-maint verify` run produced for one target.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "tool", "source", "target", "artifacts", "runtime", "takaro", "level", "checks", "outcome", "startedAt", "finishedAt", "logs", "coverage"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "runtime-verification"},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "revision", "dirty"],
      "properties": {
        "repo": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "dirty": {"type": "boolean"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["game", "id", "fingerprint", "inputs"],
      "properties": {
        "game": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url"],
            "properties": {
              "url": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "size": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "file", "sha256", "connectorVersion"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "file": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "connectorVersion": {"type": "string", "minLength": 1}
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "gameVersion", "loader", "loaderVersion", "java"],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "digest"],
          "properties": {
            "ref": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        },
        "gameVersion": {"type": ["string", "null"]},
        "loader": {"type": ["string", "null"]},
        "loaderVersion": {"type": ["string", "null"]},
        "java": {"type": ["integer", "null"]}
      }
    },
    "takaro": {"enum": ["local", "hosted"]},
    "level": {"enum": ["none", "build", "contract", "startup", "protocol", "gameplay"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "durationMs", "detail"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "skip"]},
          "durationMs": {"type": "integer", "minimum": 0},
          "detail": {"type": "object", "additionalProperties": true},
          "log": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file"],
            "properties": {
              "file": {"type": "string", "minLength": 1},
              "line": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "outcome": {"enum": ["pass", "fail"]},
    "startedAt": {"type": "string", "minLength": 20},
    "finishedAt": {"type": "string", "minLength": 20},
    "logs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gameplay"],
      "properties": {
        "gameplay": {"type": "string", "minLength": 1},
        "verificationRunner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision", "dirty"],
          "properties": {
            "revision": {"type": "string", "minLength": 1},
            "dirty": {"type": "boolean"}
          }
        },
        "readOnlyBase": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "readOnlyMount", "steamApp", "steamBuild", "depotManifests", "appManifestSha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "readOnlyMount": {"const": true},
            "steamApp": {"type": "string", "minLength": 1},
            "steamBuild": {"type": "string", "minLength": 1},
            "depotManifests": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
            "appManifestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    }
  }
}
