{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gettakaro/connectors/catalog/schema/v1/game.schema.json",
  "title": "Catalog game record",
  "description": "One game: the sources its targets download from, how its connector is built, and which artifact roles it ships.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "connector", "platforms", "sources", "build", "componentRoles", "legacyAssetAliases"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "connector": {"type": "string", "minLength": 1, "description": "release-please component name"},
    "platforms": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}},
    "defaultPlatform": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Which platform a command that names only --game resolves to, when several platforms each declare a default target. Must be one of platforms."
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "baseUrl"],
        "properties": {
          "provider": {"type": "string", "minLength": 1},
          "baseUrl": {"type": "string", "pattern": "^https?://[^/]+$"},
          "watch": {
            "type": "object",
            "description": "Optional observation config; filled by the release-tracking issues.",
            "additionalProperties": true
          }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "projectDir"],
      "properties": {
        "system": {"type": "string", "minLength": 1},
        "projectDir": {"type": "string", "minLength": 1},
        "versionCatalog": {"type": "string", "minLength": 1}
      }
    },
    "componentRoles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "artifactPattern"],
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "artifactPattern": {"type": "string", "minLength": 1}
        }
      }
    },
    "legacyAssetAliases": {
      "type": "object",
      "description": "Old release asset names kept discoverable; filled by the complete-target-set issue.",
      "additionalProperties": {"type": "string"}
    },
    "frameworks": {
      "type": "object",
      "description": "Optional framework observation config; filled by the platform-readiness issue.",
      "additionalProperties": true
    },
    "snapshots": {
      "type": "object",
      "description": "Optional preview/snapshot channel config; filled by the platform-readiness issue.",
      "additionalProperties": true
    },
    "devServers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["composeFile"],
      "properties": {"composeFile": {"type": "string", "minLength": 1}}
    },
    "icons": {"$ref": "icons.schema.json"}
  }
}
