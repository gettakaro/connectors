{
  "schemaVersion": 1,
  "id": "valheim",
  "name": "Valheim",
  "connector": "valheim",
  "platforms": ["linux"],
  "sources": {
    "steam": {
      "provider": "steam",
      "baseUrl": "https://store.steampowered.com",
      "watch": {
        "kind": "game",
        "component": "valheim",
        "app": 896660,
        "os": "linux",
        "depots": ["896661"],
        "channels": {
          "public": {"branch": "public"},
          "public-test": {"branch": "public-test", "enabled": false}
        },
        "knownBranches": ["regex:^default_(old|pre[a-z0-9_]+)$"]
      }
    },
    "thunderstore": {
      "provider": "thunderstore",
      "baseUrl": "https://thunderstore.io",
      "watch": {
        "kind": "framework",
        "component": "valheim",
        "namespace": "denikson",
        "name": "BepInExPack_Valheim",
        "channels": {"latest": {"branch": "release"}}
      }
    }
  },
  "build": {"system": "script", "projectDir": "games/valheim"},
  "componentRoles": {
    "server-plugin": {
      "description": "Dedicated-server BepInEx plugin folder (BepInEx/plugins/TakaroValheim); the only half that holds the Takaro token",
      "artifactPattern": "takaro-valheim-plugin-{target}-{version}.zip"
    },
    "client-companion": {
      "description": "Optional graphical-client BepInEx mod (BepInEx/plugins/TakaroValheimInventoryCompanion) that reports the player's inventory; never loaded by the dedicated server, holds no Takaro credentials",
      "artifactPattern": "takaro-valheim-inventory-companion-{target}-{version}.zip"
    }
  },
  "legacyAssetAliases": {
    "takaro-valheim-plugin.zip": "linux-1.0.16/server-plugin",
    "takaro-valheim-inventory-companion.zip": "linux-1.0.16/client-companion"
  },
  "devServers": {"composeFile": "valheim.yml"}
}
