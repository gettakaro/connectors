{
  "schemaVersion": 1,
  "id": "rust",
  "name": "Rust",
  "connector": "rust",
  "platforms": ["carbon"],
  "sources": {
    "steam": {
      "provider": "steam",
      "baseUrl": "https://store.steampowered.com",
      "watch": {
        "kind": "game",
        "component": "rust",
        "app": 258550,
        "os": "linux",
        "depots": ["258552", "258554"],
        "channels": {
          "public": {"branch": "public"},
          "release": {"branch": "release", "enabled": false},
          "staging": {"branch": "staging", "enabled": false}
        },
        "knownBranches": ["aux02", "debug", "last-month", "regex:^aux[0-9]+$"]
      }
    },
    "carbon-api": {
      "provider": "github-release",
      "baseUrl": "https://api.github.com",
      "watch": {
        "kind": "framework",
        "component": "carbon",
        "repo": "CarbonCommunity/Carbon",
        "window": 10,
        "channels": {
          "production": {
            "branch": "release",
            "tag": "production_build",
            "asset": "^Carbon\\.Linux\\.Release\\.tar\\.gz$",
            "versionPattern": "v([0-9][0-9.]*)",
            "mutable": true
          }
        }
      }
    },
    "carbon-download": {"provider": "github-release", "baseUrl": "https://github.com"}
  },
  "build": {"system": "script", "projectDir": "games/rust"},
  "componentRoles": {
    "plugin": {
      "description": "The single-file Carbon/Oxide plugin source the server compiles at load (carbon/plugins/TakaroConnector.cs)",
      "artifactPattern": "takaro-rust-plugin-{target}-{version}.cs"
    }
  },
  "legacyAssetAliases": {"TakaroConnector.cs": "carbon-25823813/plugin"},
  "devServers": {"composeFile": "rust.yml"}
}
