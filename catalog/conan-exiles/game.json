{
  "schemaVersion": 1,
  "id": "conan-exiles",
  "name": "Conan Exiles",
  "connector": "conan-exiles",
  "platforms": [
    "linux",
    "windows"
  ],
  "defaultPlatform": "linux",
  "sources": {
    "steam": {
      "provider": "steam",
      "baseUrl": "https://store.steampowered.com",
      "watch": {
        "kind": "game",
        "component": "conan-exiles",
        "app": 443030,
        "os": "linux",
        "depots": [
          "443032"
        ],
        "channels": {
          "public": {
            "branch": "public"
          },
          "conan-exiles-legacy": {
            "branch": "legacy",
            "enabled": false
          }
        },
        "knownBranches": [],
        "readinessNote": "One Steam build id covers both platforms (content depot 443032 Linux, 443031 Windows). The native connector hooks only server builds pinned in games/conan-exiles/native/core/pins/pins.json (GNU build-id on Linux, PE TimeDateStamp-SizeOfImage on Windows); on any other build it connects, reports the unknown build and refuses every action until the build is re-pinned (games/conan-exiles/native/tools/repin.py)."
      }
    }
  },
  "build": {
    "system": "script",
    "projectDir": "games/conan-exiles"
  },
  "componentRoles": {
    "native": {
      "description": "The native connector, loaded into the dedicated server process: libtakaro-conan-native.so through LD_PRELOAD on Linux, a winmm.dll proxy next to ConanSandboxServer-Win64-Shipping.exe on Windows. It holds the Takaro connection itself; no sidecar, no RCON",
      "artifactPattern": "takaro-conan-exiles-native-{target}-{version}.zip"
    }
  },
  "legacyAssetAliases": {},
  "devServers": {
    "composeFile": "conan-exiles.yml"
  },
  "icons": {
    "game": "conan-exiles",
    "mapper": "conan-exiles",
    "unreal": {"engine": "GAME_ConanExilesEnhanced", "aesKeyEnv": null},
    "data": {
      "source": "server-depot",
      "input": "server",
      "depots": ["443032"],
      "decoder": "unreal",
      "files": [
        "regex:^ConanSandbox/Content/Paks/(global\\.(utoc|ucas)|pakchunk0-LinuxServer\\.(pak|utoc|ucas)|pakchunk(1050|1100|50[0-9]0|51[0-5]0)-LinuxServer\\.(utoc|ucas))$"
      ]
    },
    "pixels": {
      "source": "client",
      "app": 440900,
      "depot": 440901,
      "decoder": "unreal",
      "access": "iostore-ranges",
      "files": [
        "ConanSandbox/Content/Paks/global.utoc",
        "ConanSandbox/Content/Paks/pakchunk1100-Windows.utoc",
        "ConanSandbox/Content/Paks/pakchunk1110-Windows.utoc",
        "ConanSandbox/Content/Paks/pakchunk5000-Windows.utoc",
        "ConanSandbox/Content/Paks/pakchunk5010-Windows.utoc",
