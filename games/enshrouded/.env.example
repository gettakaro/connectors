# Copy to .env next to docker-compose.example.yml
TAKARO_REGISTRATION_TOKEN=
# Optional: leave empty and the connector keeps a generated identity in takaro/plugin.json
TAKARO_IDENTITY_ENSHROUDED=
# Optional: the name shown in Takaro (default: the server name plus the start of the identity)
TAKARO_SERVER_NAME=
# Optional: a long random secret for the plugin's diagnostics endpoint (e.g. `openssl rand -hex 32`)
TAKARO_ENSHROUDED_PLUGIN_TOKEN=
ENSHROUDED_ADMIN_PASSWORD=
ENSHROUDED_PLAYER_PASSWORD=
ENSHROUDED_GUEST_PASSWORD=
