  {
   "name": "executeConsoleCommand returns CommandOutput",
   "steps": [
    {
     "action": "executeConsoleCommand",
     "args": {
      "command": "save"
     },
     "expect": {
      "payload": {
       "success": true,
       "rawResult": "ran save",
       "errorMessage": null
      }
     },
     "request": {
      "method": "POST",
      "path": "/command",
      "body": {
       "command": "save"
      },
      "found": true
     }
    },
    {
     "action": "executeConsoleCommand",
     "args": {},
     "expect": {
      "error": "executeConsoleCommand requires 'command'"
     }
    },
    {
     "action": "executeConsoleCommand",
     "args": {
      "command": null
     },
     "expect": {
      "error": "executeConsoleCommand requires 'command'"
     }
    }
   ]
  },
  {
   "name": "executeConsoleCommand failure",
   "setup": {
    "commandResult": {
     "success": false,
     "output": "unknown command"
    }
   },
   "steps": [
    {
     "action": "executeConsoleCommand",
     "args": {
      "command": "nope"
     },
     "expect": {
      "payload": {
       "success": false,
       "rawResult": "unknown command",
       "errorMessage": "unknown command"
      }
     }
    }
   ]
  },
  {
   "name": "executeConsoleCommand failure without output",
   "setup": {
    "commandResult": {
     "success": false,
     "output": ""
    }
   },
   "steps": [
    {
     "action": "executeConsoleCommand",
     "args": {
      "command": "nope"
     },
     "expect": {
      "payload": {
       "success": false,
       "rawResult": "",
       "errorMessage": "Command failed"
      }
     }
    }
   ]
  },
  {
   "name": "sendMessage: global, opts.recipient, senderNameOverride, explicit nulls",
   "steps": [
    {
     "action": "sendMessage",
     "args": {
      "message": "hello all"
     },
     "expect": {
      "payload": {
       "success": true
      }
     },
     "request": {
      "method": "POST",
      "path": "/message",
      "body": {
       "text": "hello all"
      },
      "found": true
     }
    },
    {
     "action": "sendMessage",
     "args": {
      "message": "Welcome",
      "opts": {
       "recipient": {
        "gameId": "76561198000005875"
       },
       "senderNameOverride": "Takaro"
      }
     },
     "expect": {
      "payload": {
       "success": true
      }
     },
     "request": {
      "method": "POST",
      "path": "/message",
      "body": {
       "text": "Takaro: Welcome",
       "recipientGameId": "76561198000005875"
      },
      "found": true
     }
    },
    {
     "action": "sendMessage",
     "args": {
      "message": "hi",
      "opts": null
     },
     "expect": {
      "payload": {
       "success": true
      }
     },
     "request": {
      "method": "POST",
      "path": "/message",
      "body": {
       "text": "hi"
      },
      "found": true
     }
    },
    {
     "action": "sendMessage",
     "args": {
      "message": "hi",
      "opts": {
       "recipient": null,
       "senderNameOverride": null
      }
     },
     "expect": {
      "payload": {
       "success": true
      }
     },
     "request": {
      "method": "POST",
      "path": "/message",
      "body": {
       "text": "hi"
      },
      "found": true
     }
    },
    {
     "action": "sendMessage",
     "args": {
      "message": "dm",
      "opts": {
       "recipient": {
        "steamId": "steam:76561198000001111"
       }
      }
     },
     "expect": {
      "payload": {
       "success": true
      }
     },
     "request": {
      "method": "POST",
      "path": "/message",
      "body": {
       "text": "dm",
       "recipientGameId": "76561198000001111"
      },
      "found": true
     }
    },
    {
     "action": "sendMessage",
     "args": {
      "message": "dm2",
      "recipientGameId": "Limon"
     },
     "expect": {
      "payload": {
       "success": true
      }
     },
     "request": {
      "method": "POST",
      "path": "/message",
      "body": {
       "text": "dm2",
       "recipientGameId": "76561198000005875"
      },
      "found": true
     }
    },
    {
     "action": "sendMessage",
     "args": {
      "message": "  padded  "
     },
     "expect": {
      "payload": {
       "success": true
      }
     },
     "request": {
      "method": "POST",
      "path": "/message",
      "body": {
       "text": "padded"
      },
      "found": true
     }
    },
    {
     "action": "sendMessage",
     "args": {},
     "expect": {
      "error": "sendMessage requires 'message'"
     }
    },
    {
     "action": "sendMessage",
     "args": {
      "message": "   "
     },
     "expect": {
      "error": "sendMessage requires 'message'"
     }
    }
   ]
  },
