  {
   "name": "giveItem: item key, amount/quantity, quality, explicit nulls, errors",
   "steps": [
    {
     "action": "giveItem",
     "args": {
      "player": {
       "gameId": "76561198000005875"
      },
      "item": "Torch",
      "amount": 5,
      "quality": "2"
     },
     "expect": {
      "payload": {}
     },
     "request": {
      "method": "POST",
      "path": "/give",
      "body": {
       "gameId": "76561198000005875",
       "code": "Torch",
       "amount": 5,
       "quality": "2"
      },
      "found": true
     }
    },
    {
     "action": "giveItem",
     "args": "{\"gameId\":\"76561198000005875\",\"item\":\"Wood\",\"amount\":1}",
     "expect": {
      "payload": {}
     },
     "request": {
      "method": "POST",
      "path": "/give",
      "body": {
       "gameId": "76561198000005875",
       "code": "Wood",
       "amount": 1
      },
      "found": true
     }
    },
    {
     "action": "giveItem",
     "args": {
      "gameId": "76561198000005875",
      "item": "Wood",
      "amount": 3,
      "quality": null
     },
     "expect": {
      "payload": {}
     },
     "request": {
      "method": "POST",
      "path": "/give",
      "body": {
       "gameId": "76561198000005875",
       "code": "Wood",
       "amount": 3
      },
      "found": true
     }
    },
    {
     "action": "giveItem",
     "args": {
      "gameId": "76561198000005875",
      "itemCode": "Wood",
      "quantity": "7"
     },
     "expect": {
      "payload": {}
     },
     "request": {
      "method": "POST",
      "path": "/give",
      "body": {
       "gameId": "76561198000005875",
       "code": "Wood",
       "amount": 7
      },
      "found": true
     }
    },
    {
     "action": "giveItem",
     "args": {
      "gameId": "76561198000005875",
      "item": {
       "code": "Torch"
      },
      "amount": null,
      "quality": 4
     },
     "expect": {
      "payload": {}
     },
     "request": {
      "method": "POST",
      "path": "/give",
      "body": {
       "gameId": "76561198000005875",
       "code": "Torch",
       "amount": 1,
       "quality": "4"
      },
      "found": true
     }
    },
    {
     "action": "giveItem",
     "args": {
      "gameId": "76561198000005875",
      "code": " Wood ",
      "amount": 2,
      "quality": ""
     },
     "expect": {
      "payload": {}
     },
     "request": {
      "method": "POST",
      "path": "/give",
      "body": {
       "gameId": "76561198000005875",
       "code": "Wood",
       "amount": 2
      },
      "found": true
     }
    },
    {
     "action": "giveItem",
     "args": {
      "gameId": "76561198000005875"
     },
     "expect": {
      "error": "giveItem requires 'item'"
     }
    },
    {
     "action": "giveItem",
     "args": {
      "gameId": "76561198000005875",
      "item": "Wood",
      "amount": 0
     },
     "expect": {
      "error": "giveItem amount must be positive"
     }
    },
    {
     "action": "giveItem",
     "args": {
      "gameId": "76561198000005875",
      "item": "Wood",
      "amount": -2
     },
     "expect": {
      "error": "giveItem amount must be positive"
     }
    },
    {
     "action": "giveItem",
     "args": {
      "gameId": "nobody",
      "item": "Wood",
      "amount": 1
     },
     "expect": {
      "error": "Enshrouded plugin HTTP 404 for /give: player not online"
     }
    }
   ]
  },
