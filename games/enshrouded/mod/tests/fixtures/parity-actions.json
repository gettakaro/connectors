  {
   "name": "getPlayer flat, nested, JSON string, steam: prefix, name, platformId, playerRef; unknown -> {}",
   "steps": [
    {
     "action": "getPlayer",
     "args": {
      "gameId": "76561198000005875"
     },
     "expect": {
      "payload": {
       "gameId": "76561198000005875",
       "name": "Limon",
       "steamId": "76561198000005875",
       "platformId": "steam:76561198000005875"
      }
     }
    },
    {
     "action": "getPlayer",
     "args": {
      "player": {
       "gameId": "76561198000005875"
      }
     },
     "expect": {
      "payload": {
       "gameId": "76561198000005875",
       "name": "Limon",
       "steamId": "76561198000005875",
       "platformId": "steam:76561198000005875"
      }
     }
    },
    {
     "action": "getPlayer",
     "args": "{\"gameId\":\"76561198000005875\"}",
     "expect": {
      "payload": {
       "gameId": "76561198000005875",
       "name": "Limon",
       "steamId": "76561198000005875",
       "platformId": "steam:76561198000005875"
      }
     }
    },
    {
     "action": "getPlayer",
     "args": {
      "gameId": "steam:76561198000005875"
     },
     "expect": {
      "payload": {
       "gameId": "76561198000005875",
       "name": "Limon",
       "steamId": "76561198000005875",
       "platformId": "steam:76561198000005875"
      }
     }
    },
    {
     "action": "getPlayer",
     "args": {
      "gameId": "limon"
     },
     "expect": {
      "payload": {
       "gameId": "76561198000005875",
       "name": "Limon",
       "steamId": "76561198000005875",
       "platformId": "steam:76561198000005875"
      }
     }
    },
    {
     "action": "getPlayer",
     "args": {
      "platformId": "steam:76561198000001111"
     },
     "expect": {
      "payload": {
       "gameId": "76561198000001111",
       "name": "Guest",
       "steamId": "76561198000001111",
       "platformId": "steam:76561198000001111"
      }
     }
    },
    {
     "action": "getPlayer",
     "args": {
      "playerRef": {
       "steamId": "76561198000001111"
      }
     },
     "expect": {
      "payload": {
       "gameId": "76561198000001111",
       "name": "Guest",
       "steamId": "76561198000001111",
       "platformId": "steam:76561198000001111"
      }
     }
    },
    {
     "action": "getPlayer",
     "args": {
      "gameId": "123"
     },
     "expect": {
      "payload": {}
     }
    },
    {
     "action": "getPlayer",
     "args": [],
     "expect": {
      "error": "Expected player identifier (gameId, or player.gameId)"
     }
    },
    {
     "action": "getPlayer",
     "args": {
      "gameId": null,
      "steamId": null,
      "player": {
       "gameId": "76561198000005875"
      }
     },
     "expect": {
      "payload": {
       "gameId": "76561198000005875",
       "name": "Limon",
       "steamId": "76561198000005875",
       "platformId": "steam:76561198000005875"
      }
     }
    },
    {
     "action": "getPlayer",
     "args": {
      "gameId": "   "
     },
     "expect": {
      "error": "Expected player identifier (gameId, or player.gameId)"
     }
    }
   ]
  },
  {
   "name": "getPlayerLocation resolves steamId to plugin gameId; unknown is a 404 error",
   "steps": [
    {
     "action": "getPlayerLocation",
     "args": {
      "player": {
       "gameId": "76561198000005875"
      }
     },
     "expect": {
      "payload": {
       "x": 10.5,
       "y": 20,
       "z": -3
      }
     },
     "request": {
      "method": "GET",
      "path": "/players/76561198000005875/location",
      "found": true
     }
    },
    {
     "action": "getPlayerLocation",
     "args": {
      "gameId": "nobody"
     },
     "expect": {
      "error": "Enshrouded plugin HTTP 404 for /players/nobody/location: player not found"
     }
    },
    {
     "action": "getPlayerLocation",
     "args": {
      "gameId": "a b/c"
     },
     "expect": {
      "error": "Enshrouded plugin HTTP 404 for /players/a%20b%2Fc/location: player not found"
     }
    }
   ]
  },
  {
   "name": "getPlayerLocation 501 without an event window is an error",
   "setup": {
    "unimplemented": [
     "GET /players/:id/location"
    ]
   },
   "steps": [
    {
     "action": "getPlayerLocation",
     "args": {
      "gameId": "76561198000005875"
     },
     "expect": {
      "error": "Enshrouded connector cannot perform 'getPlayerLocation': Enshrouded plugin has not implemented /players/76561198000005875/location (HTTP 501): not implemented in this build"
     }
    }
   ]
  },
