{
  "game": "empyrion",
  "connector": "takaro-empyrion",
  "statusVocabulary": [
    "live-supported",
    "schema-fallback",
    "unsupported"
  ],
  "note": "Generated from mod/src/Core/Coverage.cs; liveVerified is set only by a committed live run.",
