# Takaro Dune: Awakening connector (sidecar) — example environment.
# Copy to .env and fill in. Never commit a filled-in .env: four of these values are secrets.

# ---------------------------------------------------------------------------
# Takaro
# ---------------------------------------------------------------------------
TAKARO_REGISTRATION_TOKEN=            # registration token for a GENERIC game server
TAKARO_IDENTITY_TOKEN=dune            # identity this server registers with
TAKARO_WS_URL=wss://connect.takaro.io/
TAKARO_SERVER_NAME=Dune
# TAKARO_SENDER_NAME=Server           # name players see as the sender of connector messages
# TAKARO_RECONNECT_BASE_MS=2000
# TAKARO_RECONNECT_MAX_MS=60000

# ---------------------------------------------------------------------------
# Battlegroup Postgres (READ-ONLY; the connector performs no DB writes)
# The DATABASE NAME is not fixed across builds (`dune`, `dune_sb_1_4_0_0`, …) — look it up with `\l`.
# ---------------------------------------------------------------------------
DUNE_PG_URL=postgres://dune:CHANGE_ME@postgres:5432/dune
# ...or the discrete parts instead of DUNE_PG_URL:
# DUNE_PG_HOST=postgres
# DUNE_PG_PORT=5432
# DUNE_PG_DATABASE=dune
# DUNE_PG_USER=dune
# DUNE_PG_PASSWORD=
# DUNE_PG_SCHEMA=dune                 # schema the game's tables live in
# DUNE_PG_STATEMENT_TIMEOUT_MS=5000
# DUNE_PG_POOL_MAX=4
# DUNE_INVENTORY_TYPES=0,1,14,15,27,30  # 0 = backpack, the rest are gear/equipment containers

# ---------------------------------------------------------------------------
# Game RabbitMQ (chat in/out, and the AMQP GM publisher)
# ---------------------------------------------------------------------------
DUNE_RMQ_URL=amqps://user:CHANGE_ME@game-rmq:5672/
DUNE_RMQ_TLS_INSECURE=true            # the shipped broker certificate is self-signed
# DUNE_CHAT_QUEUE=takaro_chat_intercept
# DUNE_CHAT_INTERCEPT_EXCHANGE=chat.intercept
# DUNE_CHAT_INTERCEPT_ROUTING_KEY=#
# DUNE_CHAT_WHISPER_EXCHANGE=chat.whispers
# DUNE_CHAT_MAP_EXCHANGE=chat.map
# DUNE_ANNOUNCER_FUNCOM_ID=ADMIN#00001  # m_FuncomIdFrom our own messages claim
# DUNE_GLOBAL_MESSAGE_MODE=chat        # chat | broadcast | both

# --- chat wire variants: build-sensitive, flip these on the live probe, no rebuild needed ---
# DUNE_CHAT_TIMESTAMP_FIELD=m_TimeStamp    # rollback knob: m_Timestamp
# DUNE_CHAT_WHISPER_CHANNEL_TYPE=Map      # m_ChannelType of a private line; Whispers renders empty on build 25635074
# DUNE_CHAT_TIMESTAMP_FORMAT=ue            # ue (%Y.%m.%d-%H.%M.%S) | rfc3339
# DUNE_CHAT_CHANNEL_ENUM_FORM=short        # short (Whispers) | qualified (ETextChatChannelType::Whispers)
# DUNE_CHAT_CONTENT_KEY=Content            # Content | content
# DUNE_CHAT_CONTENT_TYPE=Content           # AMQP content_type
# DUNE_CHAT_AMQP_TYPE=text_chat            # AMQP type
# DUNE_CHAT_DELIVERY_MODE=1                # 1 = transient (what the confirmed probes used) | 2
# DUNE_CHAT_BODY_TYPE=TextChat             # outer `Type` discriminator

# ---------------------------------------------------------------------------
# GM commands (the only write path into the game)
# Requires on EVERY map process: server.NotificationSystem.Enabled=true
#   and [FuncomLiveServices] ServerCommandsAuthToken=<this value>
# ---------------------------------------------------------------------------
DUNE_GM_AUTH_TOKEN=                   # == ServerCommandsAuthToken; SECRET
DUNE_GM_PUBLISHER=amqp                # amqp | docker-exec | kubectl-exec
# DUNE_GM_PLAYER_ID_KIND=fls          # fls | funcom | name — which id the PlayerId field carries
# DUNE_GM_EXCHANGE=heartbeats
# DUNE_GM_ROUTING_KEY=notifications
# DUNE_GM_USER_ID=fls                 # AMQP user_id the server checks
# DUNE_GM_APP_ID=fls_backend
# --- publisher = amqp: the broker validates user_id against the authenticated user ---
# DUNE_GM_AMQP_USER=fls
# DUNE_GM_AMQP_PASS=
# --- publisher = docker-exec: publish from inside the broker container ---
# DUNE_RMQ_CONTAINER=dune_server-game-rmq-1
# DUNE_DOCKER_BIN=docker
# --- publisher = kubectl-exec: the same, on a k3s install ---
# DUNE_K8S_NAMESPACE=default
# DUNE_K8S_POD=
# DUNE_KUBECTL_BIN=kubectl
# DUNE_EXEC_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# Optional native plugin (libtakaro-dune.so) — entity-killed, death attribution,
# live location, precise connect/disconnect. Everything else works without it.
# ---------------------------------------------------------------------------
# DUNE_PLUGIN_URL=http://127.0.0.1:18890
# DUNE_PLUGIN_TOKEN=                  # generate: openssl rand -hex 32
# DUNE_PLUGIN_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Polling and verification
# ---------------------------------------------------------------------------
# DUNE_PRESENCE_INTERVAL_MS=5000      # how often the roster is diffed for connect/disconnect/death
# TAKARO_POLL_INTERVAL_MS=1000        # plugin /events and log tail
# TAKARO_HEALTH_INTERVAL_MS=15000
# DUNE_TRANSFER_GRACE_SECONDS=45      # a map transfer must not look like a disconnect
# DUNE_VERIFY_WINDOW_MS=8000          # how long a mutation read-back may poll before verified:false
# DUNE_VERIFY_INTERVAL_MS=500
# DUNE_BAN_KICK_COOLDOWN_MS=15000

# ---------------------------------------------------------------------------
# State (keep the volume, or bans are lost and events replay)
# ---------------------------------------------------------------------------
TAKARO_DATA_DIR=/data
# TAKARO_CURSOR_FILE=/data/event-cursor.json
# TAKARO_ONLINE_FILE=/data/online-players.json
# TAKARO_BAN_FILE=/data/bans.json
# TAKARO_KNOWN_PLAYERS_FILE=/data/known-players.json
# DUNE_ITEMS_FILE=/app/data/items.json
# DUNE_ENTITIES_FILE=/app/data/entities.json

# ---------------------------------------------------------------------------
# Log forwarding (optional; Dune has no documented log grammar, so lines are
# forwarded verbatim after redaction — nothing is parsed out of them)
# ---------------------------------------------------------------------------
# DUNE_LOG_FILE=                      # empty disables the log tail
# DUNE_LOG_EVENTS=filtered            # all | filtered | none

# ---------------------------------------------------------------------------
# Shutdown. The GM ServerShutdown command is only a countdown NOTICE; it does
# not stop the process. Without a hook the shutdown action refuses.
# ---------------------------------------------------------------------------
# DUNE_SHUTDOWN_CMD=docker stop dune-survival-1
# DUNE_SHUTDOWN_NOTICE_SECONDS=60

# ---------------------------------------------------------------------------
# Health endpoint and watchdog
# ---------------------------------------------------------------------------
SIDECAR_HEALTH_HOST=127.0.0.1
SIDECAR_HEALTH_PORT=18891
SIDECAR_EXIT_AFTER_DEPENDENCY_LOSS_MS=180000
DEBUG=0                               # 1 logs every wire frame (secrets are redacted regardless)
