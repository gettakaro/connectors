# Takaro RuneScape: Dragonwilds native connector — example environment
# Copy to .env and fill in. Never commit a filled-in .env.

# --- direct Takaro connection from libtakaro-dragonwilds.so ---
TAKARO_REGISTRATION_TOKEN=           # registration token for a GENERIC game server
TAKARO_IDENTITY_TOKEN=dragonwilds    # keep the same identity when upgrading
TAKARO_WS_URL=wss://connect.takaro.io/
TAKARO_SERVER_NAME=Dragonwilds
# TAKARO_SENDER_NAME=Server          # sender name shown in game for broadcasts
# TAKARO_CA_FILE=/path/to/ca.pem     # optional trusted CA bundle override; system bundle is default
# TAKARO_RECONNECT_BASE_MS=2000      # optional, clamped to the 2–60 second policy
# TAKARO_RECONNECT_MAX_MS=60000

# --- native plugin diagnostics ---
# TAKARO_PLUGIN_TOKEN=               # set to enable authenticated loopback HTTP diagnostics
TAKARO_PLUGIN_PORT=18890
# TAKARO_PLUGIN_DEBUG=0              # 1 enables token-gated /debug/* endpoints
# TAKARO_SYM_PATH=                   # override the .sym location (default: next to the server binary)
# TAKARO_TICK_BUDGET_US=500          # game-thread time per tick for connector work

# --- state: keep this directory across upgrades and restarts ---
TAKARO_STATE_DIR=/opt/takaro-state
# Defaults to connector-state under the plugin data dir. Explicit paths below take
# precedence and keep the 0.2.x sidecar's JSON file names and formats.
# TAKARO_CURSOR_FILE=/opt/takaro-state/event-cursor.json
# TAKARO_ONLINE_FILE=/opt/takaro-state/online-players.json
# TAKARO_BAN_FILE=/opt/takaro-state/timed-bans.json
# TAKARO_KNOWN_PLAYERS_FILE=/opt/takaro-state/known-players.json
# The plugin's game-enforcement bans.json stays in its data dir, separate from timed-bans.json.

# --- server log ---
DRAGONWILDS_LOG_FILE=/game/RSDragonwilds/Saved/Logs/RSDragonwilds.log
DRAGONWILDS_LOG_TAIL=auto            # auto | always | never
DRAGONWILDS_LOG_EVENTS=filtered      # filtered | all | none

# --- game server ---
DRAGONWILDS_OWNER_ID=                # the owner's EOS ProductUserId (32 hex, client Settings screen)
DRAGONWILDS_SERVER_NAME=Dragonwilds
DRAGONWILDS_WORLD_NAME=World
DRAGONWILDS_WORLD_PASSWORD=
DRAGONWILDS_ADMIN_PASSWORD=
DRAGONWILDS_PORT=7777
