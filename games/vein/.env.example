# Takaro VEIN native connector — example environment
# Copy to .env and fill in. Never commit a filled-in .env.

# --- direct Takaro connection from libtakaro-vein.so ---
TAKARO_REGISTRATION_TOKEN=           # registration token for a GENERIC game server
TAKARO_IDENTITY_TOKEN=vein            # keep the same identity when upgrading
TAKARO_WS_URL=wss://connect.takaro.io/
TAKARO_SERVER_NAME=Vein
# TAKARO_CA_FILE=/path/to/ca.pem      # optional trusted CA bundle override; system bundle is default
# TAKARO_RECONNECT_BASE_MS=2000       # optional, clamped to the 2–60 second policy
# TAKARO_RECONNECT_MAX_MS=60000
# TAKARO_SENDER_NAME=Server           # sender name shown in game for broadcasts
# TAKARO_SERVER_CHAT_NAME=            # legacy alias for the connector's chat name
# VEIN_HTTP_API=http://127.0.0.1:8080 # VEIN's built-in read-only /players fallback; set empty to disable

# --- native plugin diagnostics ---
# TAKARO_PLUGIN_TOKEN=                # set to enable authenticated loopback HTTP diagnostics
TAKARO_PLUGIN_PORT=18890
# TAKARO_PLUGIN_DEBUG=0               # 1 enables token-gated /debug/* endpoints
# TAKARO_SYM_PATH=                    # override where the plugin looks for symbols
# TAKARO_ITEM_NAMES=0                 # 1 = readable item names (costs a call per item class at boot)
# TAKARO_BROADCAST_VIA=auto           # chat | servermessage | admin | auto

# --- state: keep this directory across upgrades and restarts ---
# TAKARO_PLUGIN_DATA_DIR=/srv/vein/plugin-data
# TAKARO_STATE_DIR=/srv/vein/plugin-data/connector-state
# Defaults to connector-state under TAKARO_PLUGIN_DATA_DIR. Explicit paths below
# take precedence and retain the legacy JSON filenames/formats.
# TAKARO_CURSOR_FILE=/path/to/event-cursor.json
# TAKARO_ONLINE_FILE=/path/to/online-players.json
# TAKARO_BAN_FILE=/path/to/timed-bans.json
# TAKARO_KNOWN_PLAYERS_FILE=/path/to/known-players.json
# The plugin's game-enforcement bans.json is separate from timed-bans.json.

# --- game and log events ---
VEIN_LOG_FILE=/home/steam/vein/Vein/Saved/Logs/Vein.log
VEIN_LOG_TAIL=auto                    # auto | always | never
VEIN_LOG_EVENTS=filtered             # filtered | all | none
# Optional PCRE2 expressions; named captures gameId/name/msg/channel follow
# the legacy grammar. Incompatible overrides block native startup.
# VEIN_LOG_LOGIN_RE=
# VEIN_LOG_JOIN_RE=
# VEIN_LOG_LEAVE_RE=
# VEIN_LOG_CHAT_RE=
# VEIN_LOG_READY_RE=

# --- in-game admin ---
TAKARO_ADMIN_STEAMIDS=                # comma-separated SteamID64s
# TAKARO_SUPERADMIN_STEAMIDS=

# --- game server ---
VEIN_SERVER_NAME=Vein
VEIN_SERVER_PASSWORD=                 # join password; leave empty for an open server
VEIN_MAXPLAYERS=16
VEIN_PUBLIC=true                      # false hides server from public list
VEIN_PORT=7777
VEIN_QUERY_PORT=27015
