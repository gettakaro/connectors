# Bookworm matches VEIN's glibc. Network sources are verified by SHA-256.
FROM debian:bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates cmake curl make perl python3 pkg-config \
    && rm -rf /var/lib/apt/lists/*
ARG PREFIX=/opt/takaro-native
WORKDIR /tmp/sources
RUN curl -fsSL --retry 3 -o openssl.tar.gz https://github.com/openssl/openssl/releases/download/openssl-3.5.8/openssl-3.5.8.tar.gz \
 && echo 'a8f84a39918ec6415ce765d9b429d313ba97b8143169c172e734b9514464f5b2  openssl.tar.gz' | sha256sum -c - \
 && tar xf openssl.tar.gz \
 && cd openssl-3.5.8 \
 && CFLAGS='-O2 -fPIC -fvisibility=hidden' ./Configure linux-x86_64 no-shared no-tests no-module --prefix=$PREFIX --libdir=lib \
 && make -j4 build_sw && make install_sw
RUN curl -fsSL --retry 3 -o lws.tar.gz https://github.com/warmcat/libwebsockets/archive/refs/tags/v4.5.8.tar.gz \
 && echo 'b6ade658f4af3a823d0dc806ae5ef0623f0f4f5e2aeb895a0f77c4783840c30e  lws.tar.gz' | sha256sum -c - \
 && tar xf lws.tar.gz \
 && cmake -S libwebsockets-4.5.8 -B lws-build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=$PREFIX \
      -DCMAKE_POSITION_INDEPENDENT_CODE=ON -DCMAKE_C_FLAGS='-fvisibility=hidden' \
      -DOPENSSL_ROOT_DIR=$PREFIX -DOPENSSL_USE_STATIC_LIBS=TRUE \
      -DLWS_WITH_SHARED=OFF -DLWS_WITH_STATIC=ON -DLWS_WITH_SERVER=OFF \
      -DLWS_WITH_HTTP2=OFF -DLWS_WITH_ZLIB=OFF -DLWS_WITHOUT_EXTENSIONS=ON \
      -DLWS_WITHOUT_TESTAPPS=ON \
 && cmake --build lws-build -j4 && cmake --install lws-build
RUN curl -fsSL --retry 3 -o pcre2.tar.bz2 https://github.com/PCRE2Project/pcre2/releases/download/pcre2-10.47/pcre2-10.47.tar.bz2 \
 && echo '47fe8c99461250d42f89e6e8fdaeba9da057855d06eb7fc08d9ca03fd08d7bc7  pcre2.tar.bz2' | sha256sum -c - \
 && tar xf pcre2.tar.bz2 \
 && cd pcre2-10.47 \
 && CFLAGS='-O2 -fPIC -fvisibility=hidden' ./configure --disable-shared --enable-static --prefix=$PREFIX \
 && make -j4 && make install
RUN curl -fsSL --retry 3 -o json.tar.xz https://github.com/nlohmann/json/releases/download/v3.12.0/json.tar.xz \
 && echo '42f6e95cad6ec532fd372391373363b62a14af6d771056dbfc86160e6dfff7aa  json.tar.xz' | sha256sum -c - \
 && tar xf json.tar.xz \
 && cp -a json/include/nlohmann $PREFIX/include/
WORKDIR /src
