{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "separate-pull-requests": true,
  "include-component-in-tag": true,
  "tag-separator": "-",
  "draft": true,
  "force-tag-creation": true,
  "changelog-sections": [
    { "type": "feat", "section": "Features", "hidden": false },
    { "type": "fix", "section": "Bug Fixes", "hidden": false },
    { "type": "deps", "section": "Dependencies", "hidden": false },
    { "type": "chore", "section": "Miscellaneous Chores", "hidden": false },
    { "type": "perf", "section": "Performance", "hidden": false },
    { "type": "refactor", "section": "Code Refactoring", "hidden": false },
    { "type": "revert", "section": "Reverts", "hidden": false },
    { "type": "build", "section": "Build System", "hidden": false },
    { "type": "docs", "section": "Documentation", "hidden": false },
    { "type": "style", "section": "Styles", "hidden": false },
    { "type": "test", "section": "Tests", "hidden": false },
    { "type": "ci", "section": "Continuous Integration", "hidden": false }
  ],
  "packages": {
    "games/ark": {
      "release-type": "simple",
      "component": "ark",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "sidecar/package.json", "jsonpath": "$.version" }
      ]
    },
    "games/rust": {
      "release-type": "simple",
      "component": "rust",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "generic", "path": "mod/TakaroConnector.cs" }
      ]
    },
    "games/minecraft": {
      "release-type": "simple",
      "component": "minecraft",
      "changelog-path": "CHANGELOG.md"
    },
    "games/7d2d": {
      "release-type": "simple",
      "component": "7d2d",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "generic", "path": "mod/ModInfo.xml" }
      ]
    },
    "games/zomboid": {
      "release-type": "simple",
      "component": "zomboid",
      "changelog-path": "CHANGELOG.md"
    },
    "games/valheim": {
      "release-type": "simple",
      "component": "valheim",
      "changelog-path": "CHANGELOG.md"
    },
    "games/conan-exiles": {
      "release-type": "simple",
      "component": "conan-exiles",
      "changelog-path": "CHANGELOG.md"
    },
    "games/enshrouded": {
      "release-type": "simple",
      "component": "enshrouded",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "generic", "path": "mod/src/common.h" }
      ]
    },
    "games/dragonwilds": {
      "release-type": "simple",
      "component": "dragonwilds",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "generic", "path": "mod/src/common.h" }
      ]
    },
    "games/dune": {
      "release-type": "simple",
      "component": "dune",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "generic", "path": "mod/src/common.h" }
      ]
    },
    "games/vein": {
      "release-type": "simple",
      "component": "vein",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "generic", "path": "mod/src/common.h" },
        { "type": "json", "path": "sidecar/package.json", "jsonpath": "$.version" }
      ]
    },
    "games/terraria": {
      "release-type": "simple",
      "component": "terraria",
      "changelog-path": "CHANGELOG.md"
    }
  }
}
